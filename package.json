{
  "name": "mediavault",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "bun --no-env-file ./scripts/verify-bun-version.ts",
    "build": "react-router build",
    "backfill:browser-playback-fixtures": "bun scripts/backfill-browser-compatible-playback.ts --video-id 68e5f819-15e8-41ef-90ee-8a96769311b7 --video-id 754c6828-621c-4df6-9cf8-a3d77297b85a",
    "dev": "react-router dev",
    "download:ffmpeg": "bash scripts/download-ffmpeg.sh",
    "download:shaka": "bash scripts/download-shaka-packager.sh",
    "design:lint": "bun --no-env-file x designmd lint DESIGN.md",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "bun ./build/server/index.js",
    "storage:migrate-video-access": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/migrate-video-access-model.ts",
    "storage:seed-demo": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/seed-demo-storage.ts",
    "test": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/run-vitest.ts && LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file run test:smoke:dev-auth && LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file run test:smoke:bun-auth",
    "test:integration": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/run-vitest.ts run --project integration",
    "test:media-prep": "bun run download:ffmpeg && bun run download:shaka && LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/run-vitest.ts run --project integration tests/integration/modules/ingest/ffmpeg-media-preparation.real-media.test.ts",
    "test:modules": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/run-vitest.ts run --project modules",
    "test:mutation": "MEDIAVAULT_AUTH_FAILED_LOGIN_DELAY_MS=1 LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file x stryker run",
    "test:mutation:changed": "MEDIAVAULT_AUTH_FAILED_LOGIN_DELAY_MS=1 LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/test-mutation-changed.ts",
    "test:run": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/run-vitest.ts run",
    "test:coverage": "bun run test:coverage:collect && bun run test:coverage:regression && bun run test:coverage:changed",
    "test:coverage:collect": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/run-vitest.ts run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:coverage:regression": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/check-coverage-regression.ts",
    "test:coverage:changed": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/test-coverage-changed.ts",
    "test:coverage:update-baseline": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/update-coverage-baseline.ts",
    "test:e2e": "LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=Etc/UTC LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file x playwright test",
    "test:ui-dom": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/run-vitest.ts run --project ui",
    "test:smoke:dev-auth": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file test ./tests/smoke/dev-auth-gate.test.ts",
    "test:smoke:bun-auth": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file run build && LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file run test:smoke:bun-auth:run",
    "test:smoke:bun-auth:run": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file test ./tests/smoke/bun-auth-gate.test.ts",
    "vitest:ui": "bun ./scripts/run-vitest.ts --ui",
    "typecheck": "react-router typegen && tsc",
    "ui:add": "bunx --bun shadcn@4.0.0 add",
    "verify:hermetic-inputs": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/verify-hermetic-test-inputs.ts",
    "verify:data-integrity": "MEDIAVAULT_DATABASE_ENCRYPTION_KEY=${MEDIAVAULT_DATABASE_ENCRYPTION_KEY:-mediavault-local-data-integrity-key} LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/verify-data-integrity.ts",
    "check": "bun run verify:hermetic-inputs && bun run design:lint && bun run lint && bun run typecheck && bun run test:smoke:dev-auth && bun run test:coverage && bun run test:mutation:changed && bun run build && bun run test:smoke:bun-auth:run",
    "verify:docker-compose-smoke": "LOCAL_STREAMER_DISABLE_VITE_ENV_FILES=true bun --no-env-file ./scripts/verify-docker-compose-smoke.ts",
    "verify:e2e-smoke": "bun run verify:hermetic-inputs && bun run download:ffmpeg && bun run download:shaka && if [ \"${LOCAL_STREAMER_PLAYWRIGHT_INSTALL_DEPS:-}\" = \"true\" ]; then bunx playwright install --with-deps chromium; else bunx playwright install chromium; fi && bun run test:e2e -- tests/e2e/anonymous-public-access.spec.ts tests/e2e/home-library-owner-smoke.spec.ts tests/e2e/add-videos-owner-upload-smoke.spec.ts tests/e2e/playlist-owner-smoke.spec.ts tests/e2e/product-shell-smoke.spec.ts tests/e2e/player-layout.spec.ts tests/e2e/player-playback-compatibility.spec.ts",
    "verify:ci-faithful": "bun run check && bun run verify:e2e-smoke",
    "verify:ci-faithful:docker": "docker run --rm -e CI=true -e GITHUB_ACTIONS=true -e LOCAL_STREAMER_PLAYWRIGHT_INSTALL_DEPS=true -e LANG=C.UTF-8 -e LC_ALL=C.UTF-8 -e TZ=Etc/UTC -v \"$PWD\":/workspace:ro oven/bun:1.3.5 bash -lc 'apt-get update >/dev/null && apt-get install -y nodejs npm git curl xz-utils >/dev/null && git config --global --add safe.directory /workspace && mkdir -p /tmp/workspace && git -C /workspace checkout-index --all --force --prefix=/tmp/workspace/ && cd /tmp/workspace && bun install --frozen-lockfile && bun run verify:ci-faithful'",
    "verify:ci-clean-export": "bash ./scripts/verify-ci-clean-export.sh",
    "verify:ci-worktree:docker": "bash ./scripts/verify-ci-worktree-docker.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.2",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/node": "^7.7.1",
    "@vidstack/react": "^1.12.13",
    "argon2": "^0.43.1",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dashjs": "^4.7.4",
    "hono": "^4.9.0",
    "isbot": "^5.1.27",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.71.2",
    "react-router": "^7.7.1",
    "react-router-hono-server": "^2.20.0",
    "remix-utils": "^8.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@google/design.md": "^0.2.0",
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "^7.7.1",
    "@react-router/fs-routes": "^7.9.1",
    "@retn0/eslint-config": "^1.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.2.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.3.5"
}
