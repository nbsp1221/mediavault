{
  "name": "mediavault",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node ./scripts/verify-runtime.mts",
    "build": "react-router build && tsx ./scripts/check-client-boundary.ts",
    "backfill:browser-playback-fixtures": "tsx scripts/backfill-browser-compatible-playback.ts",
    "dev": "node --conditions=development --env-file-if-exists=.env ./node_modules/nodemon/bin/nodemon.js ./server.mjs --development",
    "download:ffmpeg": "bash scripts/download-ffmpeg.sh",
    "download:shaka": "bash scripts/download-shaka-packager.sh",
    "design:lint": "designmd lint DESIGN.md",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint .",
    "lint:fix": "oxlint --fix . && eslint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "start": "node ./server.mjs",
    "storage:seed-demo": "tsx ./scripts/seed-demo-storage.ts",
    "test": "tsx ./scripts/run-vitest.ts run",
    "test:integration": "tsx ./scripts/run-vitest.ts run --project integration",
    "test:media-prep": "pnpm download:ffmpeg && pnpm download:shaka && tsx ./scripts/run-vitest.ts run --project integration tests/integration/modules/ingest/ffmpeg-media-preparation.real-media.test.ts",
    "test:modules": "tsx ./scripts/run-vitest.ts run --project modules",
    "test:coverage": "pnpm test:coverage:collect && pnpm test:coverage:regression && pnpm test:coverage:changed",
    "test:coverage:collect": "tsx ./scripts/run-vitest.ts run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:coverage:regression": "tsx ./scripts/check-coverage-regression.ts",
    "test:coverage:changed": "tsx ./scripts/test-coverage-changed.ts",
    "test:coverage:update-baseline": "tsx ./scripts/update-coverage-baseline.ts",
    "test:e2e": "tsx ./scripts/run-playwright.ts",
    "test:e2e:smoke": "tsx ./scripts/run-e2e-smoke.ts",
    "test:ui-dom": "tsx ./scripts/run-vitest.ts run --project ui",
    "test:runtime:smoke": "tsx ./scripts/run-runtime-smoke.ts",
    "vitest:ui": "tsx ./scripts/run-vitest.ts --ui",
    "typecheck": "MEDIAVAULT_DISABLE_VITE_ENV_FILES=true react-router typegen && tsc",
    "ui:add": "shadcn add",
    "check:hermetic-inputs": "tsx ./scripts/verify-hermetic-test-inputs.ts",
    "check:data-integrity": "MEDIAVAULT_DATABASE_ENCRYPTION_KEY=${MEDIAVAULT_DATABASE_ENCRYPTION_KEY:-mediavault-local-data-integrity-key} tsx ./scripts/verify-data-integrity.ts",
    "check:docker-compose-smoke": "tsx ./scripts/verify-docker-compose-smoke.ts",
    "check:fast": "pnpm check:hermetic-inputs && pnpm design:lint && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "check": "pnpm check:hermetic-inputs && pnpm design:lint && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:runtime:smoke",
    "check:runtime": "pnpm check && pnpm test:e2e:smoke && pnpm check:docker-compose-smoke",
    "check:docker-worktree": "bash ./scripts/verify-ci-worktree-docker.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.1",
    "@react-router/express": "8.5.1",
    "@react-router/node": "8.5.1",
    "@videojs/media": "10.2.0",
    "@videojs/react": "10.2.0",
    "argon2": "^0.45.1",
    "async-mutex": "^0.5.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "express": "^5.3.0",
    "isbot": "^5.2.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "8.5.1",
    "shaka-player": "5.3.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.5.1",
    "@retn0/eslint-config": "^2.2.0",
    "@retn0/eslint-config-oxlint": "0.2.0",
    "@retn0/oxfmt-config": "0.3.0",
    "@retn0/oxlint-config": "3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "nodemon": "3.1.14",
    "oxfmt": "0.72.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
