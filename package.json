{
  "name": "mediavault",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "bun --no-env-file ./scripts/verify-bun-version.ts",
    "build": "react-router build",
    "backfill:browser-playback-fixtures": "bun scripts/backfill-browser-compatible-playback.ts",
    "dev": "react-router dev",
    "download:ffmpeg": "bash scripts/download-ffmpeg.sh",
    "download:shaka": "bash scripts/download-shaka-packager.sh",
    "design:lint": "bun --no-env-file x designmd lint DESIGN.md",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "bun ./build/server/index.js",
    "storage:migrate-video-access": "bun --no-env-file ./scripts/migrate-video-access-model.ts",
    "storage:seed-demo": "bun --no-env-file ./scripts/seed-demo-storage.ts",
    "test": "bun --no-env-file ./scripts/run-vitest.ts run",
    "test:integration": "bun --no-env-file ./scripts/run-vitest.ts run --project integration",
    "test:media-prep": "bun run download:ffmpeg && bun run download:shaka && bun --no-env-file ./scripts/run-vitest.ts run --project integration tests/integration/modules/ingest/ffmpeg-media-preparation.real-media.test.ts",
    "test:modules": "bun --no-env-file ./scripts/run-vitest.ts run --project modules",
    "test:mutation": "bun --no-env-file ./scripts/run-mutation.ts",
    "test:mutation:changed": "bun --no-env-file ./scripts/test-mutation-changed.ts",
    "test:coverage": "bun run test:coverage:collect && bun run test:coverage:regression && bun run test:coverage:changed",
    "test:coverage:collect": "bun --no-env-file ./scripts/run-vitest.ts run --coverage --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "test:coverage:regression": "bun --no-env-file ./scripts/check-coverage-regression.ts",
    "test:coverage:changed": "bun --no-env-file ./scripts/test-coverage-changed.ts",
    "test:coverage:update-baseline": "bun --no-env-file ./scripts/update-coverage-baseline.ts",
    "test:e2e": "bun --no-env-file ./scripts/run-playwright.ts",
    "test:e2e:smoke": "bun --no-env-file ./scripts/run-e2e-smoke.ts",
    "test:ui-dom": "bun --no-env-file ./scripts/run-vitest.ts run --project ui",
    "test:runtime:smoke": "bun --no-env-file ./scripts/run-runtime-smoke.ts",
    "vitest:ui": "bun ./scripts/run-vitest.ts --ui",
    "typecheck": "react-router typegen && tsc",
    "ui:add": "bunx --bun shadcn@4.0.0 add",
    "check:hermetic-inputs": "bun --no-env-file ./scripts/verify-hermetic-test-inputs.ts",
    "check:data-integrity": "MEDIAVAULT_DATABASE_ENCRYPTION_KEY=${MEDIAVAULT_DATABASE_ENCRYPTION_KEY:-mediavault-local-data-integrity-key} bun --no-env-file ./scripts/verify-data-integrity.ts",
    "check:docker-compose-smoke": "bun --no-env-file ./scripts/verify-docker-compose-smoke.ts",
    "check:fast": "bun run check:hermetic-inputs && bun run design:lint && bun run lint && bun run typecheck && bun run test",
    "check": "bun run check:hermetic-inputs && bun run design:lint && bun run lint && bun run typecheck && bun run test:coverage && bun run test:mutation:changed && bun run test:runtime:smoke",
    "check:runtime": "bun run check && bun run test:e2e:smoke && bun run check:docker-compose-smoke",
    "check:docker-worktree": "bash ./scripts/verify-ci-worktree-docker.sh"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.2",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/node": "^7.7.1",
    "@vidstack/react": "^1.12.13",
    "argon2": "^0.43.1",
    "async-mutex": "^0.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dashjs": "^4.7.4",
    "hono": "^4.9.0",
    "isbot": "^5.1.27",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.71.2",
    "react-router": "^7.7.1",
    "react-router-hono-server": "^2.20.0",
    "remix-utils": "^8.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@google/design.md": "^0.2.0",
    "@playwright/test": "^1.58.2",
    "@react-router/dev": "^7.7.1",
    "@react-router/fs-routes": "^7.9.1",
    "@retn0/eslint-config": "^1.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.2.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.3.5"
}
