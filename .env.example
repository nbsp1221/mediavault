# Optional unified storage root override.
# When unset, production uses ./storage and development uses repo-external storage.
# MEDIAVAULT_STORAGE_DIR=./storage

# Required database-at-rest encryption key.
# Free-form secret passed to the local SQLite encryption layer.
# Back up and preserve this with the primary SQLite database.
MEDIAVAULT_DATABASE_ENCRYPTION_KEY=

# Optional auth session and failed-login policy tuning.
MEDIAVAULT_AUTH_SESSION_TTL_MS=604800000
MEDIAVAULT_AUTH_TRUST_PROXY_HEADERS=false
MEDIAVAULT_AUTH_FAILED_LOGIN_BLOCK_DURATION_MS=300000
MEDIAVAULT_AUTH_FAILED_LOGIN_DELAY_MS=750
MEDIAVAULT_AUTH_FAILED_LOGIN_WINDOW_MS=300000
MEDIAVAULT_AUTH_MAX_FAILED_LOGIN_ATTEMPTS=5
MEDIAVAULT_AUTH_CLIENT_COOKIE_NAME=__Host-mediavault-client
MEDIAVAULT_AUTH_SESSION_COOKIE_NAME=__Host-mediavault-session

# Optional operator-only account management API.
# Use bootstrap with a strong random token for first-run Docker/GHCR account creation.
# Valid modes: disabled, bootstrap, always
MEDIAVAULT_ADMIN_API_MODE=disabled
MEDIAVAULT_ADMIN_API_TOKEN=

# Required in production for the full vault readiness contract.
# Free-form secret used to derive per-video encryption keys.
# Use a cryptographically strong random value. This does not need to be hex.
# Back up and preserve this with the storage volume and primary SQLite database.
MEDIAVAULT_MEDIA_KEY_DERIVATION_SECRET=

# Optional salt value for key derivation.
# If customized, preserve this with MEDIAVAULT_MEDIA_KEY_DERIVATION_SECRET and storage backups.
MEDIAVAULT_MEDIA_KEY_DERIVATION_SALT=mediavault-media-key-v1

# Required in production for the full vault readiness contract.
# Signing secret for protected playback tokens.
# Use a cryptographically strong random value.
MEDIAVAULT_PLAYBACK_JWT_SECRET=

# Required in production for signed client identity cookies.
# Use a cryptographically strong random value.
MEDIAVAULT_AUTH_CLIENT_COOKIE_SECRET=
