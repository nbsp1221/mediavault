# Never send operator secrets or local data to the Docker builder.
.env
.env.*
.npmrc
storage/
data/
incoming/

# Download media tools in the build stage, not from developer installations.
binaries/
.ffmpeg-download-temp/
.shaka-download-temp/

# Tests, documentation, editor state, and Git are not deployment inputs.
tests/
docs/
.github/
.vscode/
.idea/
.git/
*.md
*.log
*.pid
*.pid.lock
*.tmp
*.swp
*.swo
*.code-workspace
.DS_Store
tmp/
temp/
Dockerfile*
docker-compose*.yml
docker-compose*.yaml
.dockerignore
